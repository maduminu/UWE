// Prisma Schema for UWE (Unity Warriors Empire) Platform
// Database Provider: SQLite for local development / PostgreSQL for Production

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// -----------------------------------------------------------------------------
// 1. ADMIN USER & AUTHENTICATION
// -----------------------------------------------------------------------------
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(COMMANDER)
  tokenVersion Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum Role {
  SUPER_ADMIN
  COMMANDER
  COACH
  RECRUITER
}

// -----------------------------------------------------------------------------
// 1.1 IMMUTABLE ADMIN AUDIT LOG
// -----------------------------------------------------------------------------
model AdminAuditLog {
  id           String    @id @default(uuid())
  adminId      String?
  adminEmail   String?
  action       String    // e.g. 'USER_ENROLLED', 'SLIP_VERIFIED', 'COURSE_PRICE_CHANGED', 'BATCH_UPDATED'
  targetEntity String    // e.g. 'PaymentSlip', 'User', 'Course', 'Coupon'
  targetId     String?
  details      String?   // JSON summary of change
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([action])
  @@index([targetEntity])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetEntity, targetId])
}

// -----------------------------------------------------------------------------
// 1.2 DYNAMIC REFRESH TOKENS & ROTATION STORE (SEC-1 / SEC-7 Durable Revocation)
// -----------------------------------------------------------------------------
model RefreshToken {
  id           String   @id @default(uuid())
  jti          String   @unique
  userId       String
  userType     String   // 'admin' | 'student'
  tokenVersion Int      @default(1)
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
  @@index([userId, isRevoked, expiresAt])
}

// -----------------------------------------------------------------------------
// 2. STUDENT USER ACCOUNTS (Gated Program Access Authentication)
// -----------------------------------------------------------------------------
model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String
  phone               String?
  passwordHash        String
  isEnrolled          Boolean  @default(true)
  enrolledCourseSlugs String   @default("bmb,leadership,ignit") // Comma-separated or JSON list
  tokenVersion        Int      @default(1)
  
  // Gamification & Tactical Progression
  xp                  Int      @default(0)
  streakDays          Int      @default(1)
  lastActiveAt        DateTime @default(now())
  rankTitle           String   @default("Novice Operative")
  badges              String   @default("[\"RECRUIT\"]") // JSON array of badge IDs

  // Multi-Coach & Cohort Assignment
  assignedCoachId     String?
  assignedCoachName   String?
  cohortTag           String?  // e.g. 'ALPHA-COHORT-2026'

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([xp])
  @@index([assignedCoachId])
}

// -----------------------------------------------------------------------------
// 3. COURSES & DIVISIONS (BMB, Leadership Academy, IGNIT)
// -----------------------------------------------------------------------------
model Course {
  id          String        @id @default(uuid())
  slug        String        @unique // e.g. 'bmb', 'leadership', 'ignit'
  title       String
  subtitle    String
  badge       String        // e.g. 'MIND DIVISION'
  category    CourseCategory
  description String
  price       Decimal  @default(0.00) @db.Decimal(12, 2)
  currency    String        @default("RS.")
  duration    String        // e.g. '5 Days Intensive'
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  batches     CourseBatch[]
  leads       Lead[]
}

enum CourseCategory {
  MIND
  COMMAND
  ENTERPRISE
}

// -----------------------------------------------------------------------------
// 4. COURSE BATCHES (Zoom Live Schedules & Seat Management)
// -----------------------------------------------------------------------------
model CourseBatch {
  id                String      @id @default(uuid())
  courseId          String
  batchNumber       Int
  startDate         DateTime
  scheduleText      String      // e.g. '2026-08-25 (Zoom Live)'
  totalSeats        Int         @default(20)
  availableSeats    Int         @default(20)
  zoomLink          String?
  status            BatchStatus @default(UPCOMING)
  
  // Multi-Coach Assignment
  assignedCoachId   String?
  assignedCoachName String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  course            Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
  @@index([assignedCoachId])
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// 5. LEADS & INQUIRIES (WhatsApp & Form Submissions)
// -----------------------------------------------------------------------------
model Lead {
  id                  String      @id @default(uuid())
  name                String
  phone               String
  email               String?
  courseId            String?
  courseSlug          String?     // e.g. 'bmb'
  inquiryType         InquiryType @default(GENERAL)
  message             String?
  whatsappSent        Boolean     @default(true)
  status              LeadStatus  @default(NEW)
  notes               String?

  // Abandoned Slip Tracking
  isAbandoned         Boolean     @default(false)
  lastReminderSentAt  DateTime?

  // ── Call Tracking Fields ────────────────────────────────────────────
  // Funnel stage — tracks where in the sales pipeline this lead is
  funnelStage         FunnelStage?               // null = never positively contacted
  funnelUpdatedAt     DateTime?                  // when stage last advanced
  funnelOwnerId       String?                    // adminId who owns this lead's funnel
  funnelOwnerName     String?                    // denormalized for fast display

  // Duplicate prevention flags
  isPositiveContact   Boolean     @default(false) // true = had ANSWERED_POSITIVE → lock it
  callLockUntil       DateTime?                   // temporary 30-min lock while being called
  callLockBy          String?                     // admin name holding the active lock
  callLockById        String?                     // admin ID holding the lock

  // Quick-access call summary (updated on every CallLog insert)
  totalCallAttempts   Int         @default(0)     // total calls ever made to this lead
  lastCalledAt        DateTime?                   // timestamp of most recent call
  lastCalledBy        String?                     // name of most recent caller
  lastCallOutcome     CallOutcome?                // outcome of most recent call

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  course              Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  callLogs            CallLog[]                   // full call history

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([courseSlug])
  @@index([isAbandoned])
  @@index([isPositiveContact])
  @@index([funnelStage])
  @@index([callLockUntil])
}

enum InquiryType {
  BMB
  LEADERSHIP
  IGNIT
  CORPORATE
  JOB_APPLICATION
  GENERAL
}

enum LeadStatus {
  NEW
  CONTACTED
  ENROLLED
  REJECTED
}

// Sales funnel stage for a positively contacted lead
enum FunnelStage {
  APPROACH     // initial positive contact made
  TRUST        // building rapport/trust (follow-up)
  MONEY        // pricing/investment discussed
  CLOSING      // final close attempt
  SIGNED_UP    // enrolled — do not contact again
}

// Outcome of a single call attempt
enum CallOutcome {
  NO_ANSWER          // phone rang, nobody picked up
  ANSWERED_POSITIVE  // answered + interested / willing to continue
  ANSWERED_NEGATIVE  // answered + not interested
  CALLBACK_REQUESTED // asked to be called back at specific time
  WRONG_NUMBER       // not the right person
}

// -----------------------------------------------------------------------------
// 6. DEMO VIDEOS & PUBLIC MEDIA VAULT
// -----------------------------------------------------------------------------
model DemoVideo {
  id          String        @id @default(uuid())
  title       String
  subtitle    String
  duration    String        // e.g. '01:45'
  posterUrl   String
  videoUrl    String
  badge       String        // e.g. 'BMB MIND DIVISION'
  category    DemoCategory  @default(BMB)
  description String
  isFeatured  Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, isFeatured])
}

enum DemoCategory {
  BMB
  LEADERSHIP
  IGNIT
  TESTIMONIAL
}

// -----------------------------------------------------------------------------
// 7. PROGRAM VIDEO SERIES & MODULES (Gated Category-Wise Content)
// -----------------------------------------------------------------------------
model ProgramVideoSeries {
  id           String               @id @default(uuid())
  courseSlug   String               // 'bmb', 'leadership', 'ignit'
  seriesTitle  String
  category     String               // 'Subconscious Rewiring', 'Tactical Command', 'Incubator Pitch'
  description  String
  thumbnailUrl String
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())

  modules      ProgramVideoModule[]
}

model ProgramVideoModule {
  id            String             @id @default(uuid())
  seriesId      String
  episodeNumber Int
  title         String
  duration      String             // e.g. '12:40'
  videoUrl      String
  isFreePreview Boolean            @default(false) // Episode 1 can be free preview
  description   String?
  createdAt     DateTime           @default(now())

  series        ProgramVideoSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// 8. JOB VACANCIES & RECRUITMENT APPLICATIONS
// -----------------------------------------------------------------------------
model JobVacancy {
  id              String           @id @default(uuid())
  title           String           // e.g. 'Sales & Marketing Officer'
  department      String           @default("Sales & Growth")
  employmentType  EmploymentType   @default(WORK_FROM_HOME)
  incomeText      String           // e.g. 'Attractive Income + High Commission'
  requirements    String           // JSON or string list
  openPositions   Int              @default(5)  // Total open slots for this role
  hiredCount      Int              @default(0)  // Auto-incremented when applicant is HIRED
  hiringStatus    HiringStatus     @default(HIRING) // Derived status
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  applications    JobApplication[]
}

enum HiringStatus {
  HIRING          // Still actively recruiting
  HIRING_FINISHED // All positions filled
  PAUSED          // Paused, not accepting new applications
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  WORK_FROM_HOME
  HYBRID
}

model JobApplication {
  id          String            @id @default(uuid())
  vacancyId   String
  name        String
  phone       String
  email       String?
  experience  String?
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())

  vacancy     JobVacancy        @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId])
  @@index([status])
  @@index([vacancyId, status, createdAt])
}

enum ApplicationStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  HIRED
  REJECTED
}

// -----------------------------------------------------------------------------
// 9. ANNOUNCEMENT BANNERS (Live Ticker Alerts)
// -----------------------------------------------------------------------------
model AnnouncementBanner {
  id          String     @id @default(uuid())
  message     String
  badgeText   String?
  linkUrl     String?
  bannerType  BannerType @default(URGENT)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

enum BannerType {
  URGENT
  PROMO
  INFO
}

// -----------------------------------------------------------------------------
// 10. VIDEO WATCH PROGRESS & COMPLETION TRACKING (LMS)
// -----------------------------------------------------------------------------
model VideoProgress {
  id              String   @id @default(uuid())
  userId          String
  moduleId        String
  seriesId        String?
  isCompleted     Boolean  @default(true)
  progressPercent Int      @default(100)
  lastWatchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

// -----------------------------------------------------------------------------
// 11. BANK SLIP & PAYMENT VERIFICATION GATEWAY
// -----------------------------------------------------------------------------
model PaymentSlip {
  id            String         @id @default(uuid())
  studentName   String
  studentPhone  String
  studentEmail  String?
  courseSlug    String         // 'bmb', 'leadership', 'ignit'
  slipUrl       String         // storage key (slips/...) or HTTPS URL
  slipData      String?        // base64 data URI fallback — guarantees image is never lost
  amount        Decimal? @db.Decimal(12, 2)
  bankReference String?
  status        SlipStatus     @default(PENDING)
  notes         String?
  adminNotes    String?        // Admin's review note when verifying/rejecting
  couponCode    String?        // Coupon code applied at verification
  discountAmount Decimal? @db.Decimal(12, 2) // Discount amount applied
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([courseSlug])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([studentEmail, status])
  @@index([courseSlug, status])
}

enum SlipStatus {
  PENDING
  VERIFIED
  REJECTED
}

// -----------------------------------------------------------------------------
// 12. STAFF MEMBERS (Internal Team Directory)
// -----------------------------------------------------------------------------
model StaffMember {
  id           String       @id @default(uuid())
  name         String
  role         String       // e.g. 'Head Coach', 'Marketing Lead'
  department   String       @default("Operations")
  email        String?      @unique
  phone        String?
  photoUrl     String?
  bio          String?
  isActive     Boolean      @default(true)
  joinDate     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([isActive])
}

// -----------------------------------------------------------------------------
// 13. COUPONS & PROMO DISCOUNT CODES
// -----------------------------------------------------------------------------
model Coupon {
  id              String         @id @default(uuid())
  code            String         @unique // e.g. 'EMPIRE20', 'WARRIOR50'
  discountPercent Decimal? @db.Decimal(5, 2)  // e.g. 20.00 (for 20% off)
  discountAmount  Decimal? @db.Decimal(12, 2) // e.g. 2500.00 (for Rs. 2,500 off)
  courseSlug      String?        // 'bmb', 'leadership', 'ignit' or null for all
  maxUses         Int            @default(100)
  usedCount       Int            @default(0)
  expiryDate      DateTime?
  isActive        Boolean        @default(true)
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([code])
  @@index([isActive])
}

// -----------------------------------------------------------------------------
// 14. STUDENT REVIEWS & STAR RATINGS
// -----------------------------------------------------------------------------
model CourseReview {
  id           String    @id @default(uuid())
  courseSlug   String    // 'bmb', 'leadership', 'ignit'
  userId       String?
  studentName  String
  studentRole  String?   // e.g. 'Entrepreneur / BMB Cohort 12'
  avatarUrl    String?
  rating       Int       @default(5) // 1 to 5 stars
  title        String?
  comment      String
  isVerified   Boolean   @default(true)
  isApproved   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([courseSlug, isApproved])
  @@index([courseSlug, isApproved, createdAt(sort: Desc)])
  @@index([courseSlug, isApproved, rating])
  @@index([userId, courseSlug])
}

// -----------------------------------------------------------------------------
// 15. INSTRUCTORS & FACULTY DIRECTORY
// -----------------------------------------------------------------------------
model Instructor {
  id           String    @id @default(uuid())
  name         String
  title        String    // e.g. 'Master Commander & Mind Architect'
  bio          String
  photoUrl     String?
  credentials  String    // e.g. 'MBA (UK), Certified NLP Master, 10+ Yrs Enterprise Coaching'
  specialties  String    // e.g. 'Subconscious Reprogramming, High-Ticket Sales, Wealth Psychology'
  courseSlugs  String    @default("bmb,leadership,ignit")
  rating       Float     @default(4.9)
  studentCount Int       @default(1250)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}

// -----------------------------------------------------------------------------
// 16. COMPLETION CERTIFICATES (Verifiable Digital Credentials)
// -----------------------------------------------------------------------------
model Certificate {
  id           String    @id @default(uuid()) // Unique Verification UUID
  userId       String
  studentName  String
  courseSlug   String
  courseTitle  String
  certificateNo String   @unique // e.g. 'UWE-BMB-2026-0842'
  issuedDate   DateTime  @default(now())
  gradeScore   String    @default("HONORS (DISTINCTION)")
  signatureBy  String    @default("COMMAND COUNCIL")
  createdAt    DateTime  @default(now())

  @@index([userId, courseSlug])
  @@index([certificateNo])
}

// -----------------------------------------------------------------------------
// 17. LIVE MASTERMIND Q&A & COACH FEEDBACK
// -----------------------------------------------------------------------------
model MastermindQuestion {
  id              String             @id @default(uuid())
  courseSlug      String             // 'bmb', 'leadership', 'ignit'
  userId          String?
  authorName      String
  authorBadge     String?            // e.g. 'Operative #UWE-OP-12'
  question        String
  drillTopic      String?            // e.g. 'Day 2 Neuro-Anchoring Drills'
  answer          String?            // Legacy coach response (single-answer model)
  answeredBy      String?            // e.g. 'Commander Janith Perera'
  isAnswered      Boolean            @default(false)
  isSolved        Boolean            @default(false)  // true = a reply was marked as solution
  solutionReplyId String?            // ID of the MastermindReply marked as solution
  isPinned        Boolean            @default(false)
  upvotes         Int                @default(0)
  upvotedUserIds  String             @default("[]")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  replies         MastermindReply[]

  @@index([courseSlug, isPinned, upvotes(sort: Desc), createdAt(sort: Desc)])
  @@index([courseSlug, drillTopic])
  @@index([courseSlug, updatedAt])
}

// -----------------------------------------------------------------------------
// 17b. MASTERMIND THREADED REPLIES
// -----------------------------------------------------------------------------
model MastermindReply {
  id          String              @id @default(uuid())
  questionId  String
  userId      String?
  authorName  String
  authorBadge String?
  body        String              // Markdown content
  isCoach     Boolean             @default(false)  // true = coach/admin reply
  isSolution  Boolean             @default(false)  // "Mark as Solution" flag
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  question    MastermindQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
  @@index([questionId, isSolution])
}

// -----------------------------------------------------------------------------
// 18. NOTIFICATIONS (Command Feed & Realtime In-App Alerts)
// -----------------------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid())
  userId    String?  // null = global broadcast for all students
  title     String
  message   String
  link      String?  // e.g. '/programs/bmb?tab=qa'
  isRead    Boolean  @default(false)
  type      String?  // 'MASTERMIND_ANSWER' | 'REVIEW_APPROVED' | 'COHORT_SESSION'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// 19. BUSINESS PARTNERS (Collaborative Business Network)
// -----------------------------------------------------------------------------
model BusinessPartner {
  id             String   @id @default(uuid())
  name           String
  title          String                        // e.g. "Co-Founder & CEO"
  companyName    String
  companyType    String?                       // e.g. "Tech Startup", "Consultancy"
  industry       String?                       // e.g. "FinTech", "Retail"
  bio            String
  photoUrl       String?
  companyLogoUrl String?
  websiteUrl     String?
  linkedInUrl    String?
  cohort         String?                       // e.g. "BMB Cohort 12 / 2025"
  courseSlug     String                        // which UWE programme ('bmb','leadership','ignit')
  partnerSince   DateTime @default(now())
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  metrics        String?                       // JSON: {"revenue":"$2M","employees":"15"}
  testimonial    String?                       // Short quote for homepage callout
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, isFeatured])
  @@index([courseSlug, isActive])
}

// -----------------------------------------------------------------------------
// CALL TRACKING SYSTEM — Per-call activity log & sales funnel tracker
// -----------------------------------------------------------------------------
model CallLog {
  id             String       @id @default(uuid())

  // Who was called
  leadId         String
  leadName       String                            // denormalized for display
  leadPhone      String                            // denormalized for display

  // Who made the call
  adminId        String
  adminName      String

  // Call details
  calledAt       DateTime     @default(now())
  outcome        CallOutcome
  notes          String?                           // free text notes
  proofUrl       String?                           // Secure Supabase storage key for screenshot
  proofData      String?                           // Fallback Base64 for the screenshot
  callbackAt     DateTime?                         // if CALLBACK_REQUESTED, when?

  // Sales funnel stage data (which stages were discussed/completed this call)
  funnelStage    FunnelStage?                      // highest stage reached in this call
  stageApproach  Boolean      @default(false)      // did the approach/intro happen?
  stageTrust     Boolean      @default(false)      // was trust building done?
  stageMoney     Boolean      @default(false)      // was pricing discussed?
  stageClosing   Boolean      @default(false)      // was closing attempted?
  stageSignedUp  Boolean      @default(false)      // did they sign up on this call?

  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([adminId])
  @@index([calledAt])
  @@index([outcome])
  @@index([callbackAt])
  @@index([funnelStage])
  @@index([adminId, calledAt])   // for daily sheet queries
}
