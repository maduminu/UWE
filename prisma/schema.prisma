// Prisma Schema for UWE (Unity Warriors Empire) Platform
// Database Provider: SQLite for local development / PostgreSQL for Production

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// -----------------------------------------------------------------------------
// 1. ADMIN USER & AUTHENTICATION
// -----------------------------------------------------------------------------
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(COMMANDER)
  tokenVersion Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum Role {
  SUPER_ADMIN
  COMMANDER
  COACH
  RECRUITER
}

// -----------------------------------------------------------------------------
// 1.1 IMMUTABLE ADMIN AUDIT LOG
// -----------------------------------------------------------------------------
model AdminAuditLog {
  id           String    @id @default(uuid())
  adminId      String?
  adminEmail   String?
  action       String    // e.g. 'USER_ENROLLED', 'SLIP_VERIFIED', 'COURSE_PRICE_CHANGED', 'BATCH_UPDATED'
  targetEntity String    // e.g. 'PaymentSlip', 'User', 'Course', 'Coupon'
  targetId     String?
  details      String?   // JSON summary of change
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([action])
  @@index([targetEntity])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// 1.2 DYNAMIC REFRESH TOKENS & ROTATION STORE (SEC-1 / SEC-7 Durable Revocation)
// -----------------------------------------------------------------------------
model RefreshToken {
  id           String   @id @default(uuid())
  jti          String   @unique
  userId       String
  userType     String   // 'admin' | 'student'
  tokenVersion Int      @default(1)
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// 2. STUDENT USER ACCOUNTS (Gated Program Access Authentication)
// -----------------------------------------------------------------------------
model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  name                String
  phone               String?
  passwordHash        String
  isEnrolled          Boolean  @default(true)
  enrolledCourseSlugs String   @default("bmb,leadership,ignit") // Comma-separated or JSON list
  tokenVersion        Int      @default(1)
  
  // Gamification & Tactical Progression
  xp                  Int      @default(0)
  streakDays          Int      @default(1)
  lastActiveAt        DateTime @default(now())
  rankTitle           String   @default("Novice Operative")
  badges              String   @default("[\"RECRUIT\"]") // JSON array of badge IDs

  // Multi-Coach & Cohort Assignment
  assignedCoachId     String?
  assignedCoachName   String?
  cohortTag           String?  // e.g. 'ALPHA-COHORT-2026'

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([xp])
  @@index([assignedCoachId])
}

// -----------------------------------------------------------------------------
// 3. COURSES & DIVISIONS (BMB, Leadership Academy, IGNIT)
// -----------------------------------------------------------------------------
model Course {
  id          String        @id @default(uuid())
  slug        String        @unique // e.g. 'bmb', 'leadership', 'ignit'
  title       String
  subtitle    String
  badge       String        // e.g. 'MIND DIVISION'
  category    CourseCategory
  description String
  price       Float
  currency    String        @default("RS.")
  duration    String        // e.g. '5 Days Intensive'
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  batches     CourseBatch[]
  leads       Lead[]
}

enum CourseCategory {
  MIND
  COMMAND
  ENTERPRISE
}

// -----------------------------------------------------------------------------
// 4. COURSE BATCHES (Zoom Live Schedules & Seat Management)
// -----------------------------------------------------------------------------
model CourseBatch {
  id                String      @id @default(uuid())
  courseId          String
  batchNumber       Int
  startDate         DateTime
  scheduleText      String      // e.g. '2026-08-25 (Zoom Live)'
  totalSeats        Int         @default(20)
  availableSeats    Int         @default(20)
  zoomLink          String?
  status            BatchStatus @default(UPCOMING)
  
  // Multi-Coach Assignment
  assignedCoachId   String?
  assignedCoachName String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  course            Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
  @@index([assignedCoachId])
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// 5. LEADS & INQUIRIES (WhatsApp & Form Submissions)
// -----------------------------------------------------------------------------
model Lead {
  id                  String      @id @default(uuid())
  name                String
  phone               String
  email               String?
  courseId            String?
  courseSlug          String?     // e.g. 'bmb'
  inquiryType         InquiryType @default(GENERAL)
  message             String?
  whatsappSent        Boolean     @default(true)
  status              LeadStatus  @default(NEW)
  notes               String?
  
  // Abandoned Slip Tracking
  isAbandoned         Boolean     @default(false)
  lastReminderSentAt  DateTime?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  course              Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([courseSlug])
  @@index([isAbandoned])
}

enum InquiryType {
  BMB
  LEADERSHIP
  IGNIT
  CORPORATE
  JOB_APPLICATION
  GENERAL
}

enum LeadStatus {
  NEW
  CONTACTED
  ENROLLED
  REJECTED
}

// -----------------------------------------------------------------------------
// 6. DEMO VIDEOS & PUBLIC MEDIA VAULT
// -----------------------------------------------------------------------------
model DemoVideo {
  id          String        @id @default(uuid())
  title       String
  subtitle    String
  duration    String        // e.g. '01:45'
  posterUrl   String
  videoUrl    String
  badge       String        // e.g. 'BMB MIND DIVISION'
  category    DemoCategory  @default(BMB)
  description String
  isFeatured  Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, isFeatured])
}

enum DemoCategory {
  BMB
  LEADERSHIP
  IGNIT
  TESTIMONIAL
}

// -----------------------------------------------------------------------------
// 7. PROGRAM VIDEO SERIES & MODULES (Gated Category-Wise Content)
// -----------------------------------------------------------------------------
model ProgramVideoSeries {
  id           String               @id @default(uuid())
  courseSlug   String               // 'bmb', 'leadership', 'ignit'
  seriesTitle  String
  category     String               // 'Subconscious Rewiring', 'Tactical Command', 'Incubator Pitch'
  description  String
  thumbnailUrl String
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())

  modules      ProgramVideoModule[]
}

model ProgramVideoModule {
  id            String             @id @default(uuid())
  seriesId      String
  episodeNumber Int
  title         String
  duration      String             // e.g. '12:40'
  videoUrl      String
  isFreePreview Boolean            @default(false) // Episode 1 can be free preview
  description   String?
  createdAt     DateTime           @default(now())

  series        ProgramVideoSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// 8. JOB VACANCIES & RECRUITMENT APPLICATIONS
// -----------------------------------------------------------------------------
model JobVacancy {
  id              String           @id @default(uuid())
  title           String           // e.g. 'Sales & Marketing Officer'
  department      String           @default("Sales & Growth")
  employmentType  EmploymentType   @default(WORK_FROM_HOME)
  incomeText      String           // e.g. 'Attractive Income + High Commission'
  requirements    String           // JSON or string list
  openPositions   Int              @default(5)  // Total open slots for this role
  hiredCount      Int              @default(0)  // Auto-incremented when applicant is HIRED
  hiringStatus    HiringStatus     @default(HIRING) // Derived status
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  applications    JobApplication[]
}

enum HiringStatus {
  HIRING          // Still actively recruiting
  HIRING_FINISHED // All positions filled
  PAUSED          // Paused, not accepting new applications
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  WORK_FROM_HOME
  HYBRID
}

model JobApplication {
  id          String            @id @default(uuid())
  vacancyId   String
  name        String
  phone       String
  email       String?
  experience  String?
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())

  vacancy     JobVacancy        @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId])
  @@index([status])
}

enum ApplicationStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  HIRED
  REJECTED
}

// -----------------------------------------------------------------------------
// 9. ANNOUNCEMENT BANNERS (Live Ticker Alerts)
// -----------------------------------------------------------------------------
model AnnouncementBanner {
  id          String     @id @default(uuid())
  message     String
  badgeText   String?
  linkUrl     String?
  bannerType  BannerType @default(URGENT)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

enum BannerType {
  URGENT
  PROMO
  INFO
}

// -----------------------------------------------------------------------------
// 10. VIDEO WATCH PROGRESS & COMPLETION TRACKING (LMS)
// -----------------------------------------------------------------------------
model VideoProgress {
  id              String   @id @default(uuid())
  userId          String
  moduleId        String
  seriesId        String?
  isCompleted     Boolean  @default(true)
  progressPercent Int      @default(100)
  lastWatchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

// -----------------------------------------------------------------------------
// 11. BANK SLIP & PAYMENT VERIFICATION GATEWAY
// -----------------------------------------------------------------------------
model PaymentSlip {
  id            String         @id @default(uuid())
  studentName   String
  studentPhone  String
  studentEmail  String?
  courseSlug    String         // 'bmb', 'leadership', 'ignit'
  slipUrl       String         // storage key (slips/...) or HTTPS URL — never raw base64
  amount        Float?
  bankReference String?
  status        SlipStatus     @default(PENDING)
  notes         String?
  adminNotes    String?        // Admin's review note when verifying/rejecting
  couponCode    String?        // Coupon code applied at verification
  discountAmount Float?        // Discount amount applied
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([courseSlug])
  @@index([createdAt])
}

enum SlipStatus {
  PENDING
  VERIFIED
  REJECTED
}

// -----------------------------------------------------------------------------
// 12. STAFF MEMBERS (Internal Team Directory)
// -----------------------------------------------------------------------------
model StaffMember {
  id           String       @id @default(uuid())
  name         String
  role         String       // e.g. 'Head Coach', 'Marketing Lead'
  department   String       @default("Operations")
  email        String?      @unique
  phone        String?
  photoUrl     String?
  bio          String?
  isActive     Boolean      @default(true)
  joinDate     DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([isActive])
}

// -----------------------------------------------------------------------------
// 13. COUPONS & PROMO DISCOUNT CODES
// -----------------------------------------------------------------------------
model Coupon {
  id              String         @id @default(uuid())
  code            String         @unique // e.g. 'EMPIRE20', 'WARRIOR50'
  discountPercent Float?         // e.g. 20 (for 20% off)
  discountAmount  Float?         // e.g. 2500 (for Rs. 2,500 off)
  courseSlug      String?        // 'bmb', 'leadership', 'ignit' or null for all
  maxUses         Int            @default(100)
  usedCount       Int            @default(0)
  expiryDate      DateTime?
  isActive        Boolean        @default(true)
  description     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([code])
  @@index([isActive])
}

// -----------------------------------------------------------------------------
// 14. STUDENT REVIEWS & STAR RATINGS
// -----------------------------------------------------------------------------
model CourseReview {
  id           String    @id @default(uuid())
  courseSlug   String    // 'bmb', 'leadership', 'ignit'
  userId       String?
  studentName  String
  studentRole  String?   // e.g. 'Entrepreneur / BMB Cohort 12'
  avatarUrl    String?
  rating       Int       @default(5) // 1 to 5 stars
  title        String?
  comment      String
  isVerified   Boolean   @default(true)
  isApproved   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([courseSlug, isApproved])
}

// -----------------------------------------------------------------------------
// 15. INSTRUCTORS & FACULTY DIRECTORY
// -----------------------------------------------------------------------------
model Instructor {
  id           String    @id @default(uuid())
  name         String
  title        String    // e.g. 'Master Commander & Mind Architect'
  bio          String
  photoUrl     String?
  credentials  String    // e.g. 'MBA (UK), Certified NLP Master, 10+ Yrs Enterprise Coaching'
  specialties  String    // e.g. 'Subconscious Reprogramming, High-Ticket Sales, Wealth Psychology'
  courseSlugs  String    @default("bmb,leadership,ignit")
  rating       Float     @default(4.9)
  studentCount Int       @default(1250)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
}

// -----------------------------------------------------------------------------
// 16. COMPLETION CERTIFICATES (Verifiable Digital Credentials)
// -----------------------------------------------------------------------------
model Certificate {
  id           String    @id @default(uuid()) // Unique Verification UUID
  userId       String
  studentName  String
  courseSlug   String
  courseTitle  String
  certificateNo String   @unique // e.g. 'UWE-BMB-2026-0842'
  issuedDate   DateTime  @default(now())
  gradeScore   String    @default("HONORS (DISTINCTION)")
  signatureBy  String    @default("COMMAND COUNCIL")
  createdAt    DateTime  @default(now())

  @@index([userId, courseSlug])
  @@index([certificateNo])
}

// -----------------------------------------------------------------------------
// 17. LIVE MASTERMIND Q&A & COACH FEEDBACK
// -----------------------------------------------------------------------------
model MastermindQuestion {
  id             String   @id @default(uuid())
  courseSlug     String   // 'bmb', 'leadership', 'ignit'
  userId         String?
  authorName     String
  authorBadge    String?  // e.g. 'Operative #UWE-OP-12'
  question       String
  drillTopic     String?  // e.g. 'Day 2 Neuro-Anchoring Drills'
  answer         String?  // Coach response
  answeredBy     String?  // e.g. 'Commander Janith Perera'
  isAnswered     Boolean  @default(false)
  isPinned       Boolean  @default(false)
  upvotes        Int      @default(0)
  upvotedUserIds String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([courseSlug, isPinned])
}

