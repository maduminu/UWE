{
  "name": "uwe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan,yellow\" -n \"BACKEND,FRONTEND\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "vite",
    "backend": "nodemon --watch backend --ext ts,json --exec \"npx tsx\" backend/src/index.ts",
    "build:server": "npx esbuild backend/src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=api/index.cjs --external:@prisma/client",
    "build": "prisma generate && npm run build:server && tsc && vite build",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && npm run build:server",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.0",
    "express": "^5.2.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.30.0",
    "prisma": "^6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}